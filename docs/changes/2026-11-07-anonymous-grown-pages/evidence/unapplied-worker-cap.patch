+// Bound the ordinary lazy pool by work that entry-only scheduling can queue.
+// Count identities, not export names: aliases and an exported start deduplicate.
+static uint32_t getLazyEntryWorkerLimit(const Module &Mod) {
+  const uint32_t NumImports = Mod.getNumImportFunctions();
+  std::vector<uint32_t> Seeds;
+  const uint32_t Start = Mod.getStartFuncIdx();
+  if (Start != -1u && Start >= NumImports) {
+    Seeds.push_back(Start);
+  }
+  for (uint32_t Index : Mod.getExportedFuncIdxs()) {
+    if (Index >= NumImports) {
+      Seeds.push_back(Index);
+    }
+  }
+  std::sort(Seeds.begin(), Seeds.end());
+  const uint32_t Unique = static_cast<uint32_t>(
+      std::unique(Seeds.begin(), Seeds.end()) - Seeds.begin());
+  // Preserve the MT foreground/publication path even for an empty seed set.
+  // A zero request would also invoke ThreadPool's automatic sizing semantics.
+  return std::max(1u, Unique);
+}
