;; Scalar RHS load folding: exact FP results, shared values and trap/store order.
(module
 (memory (export "memory") 1)
 (data (i32.const 0) "\00\00\00\00\00\00\00\40\00\00\00\40")
 (func (export "f32_add") (param f32 i32) (result f32) (local.get 0) (local.get 1) (f32.load) (f32.add))
 (func (export "f32_sub") (param f32 i32) (result f32) (local.get 0) (local.get 1) (f32.load) (f32.sub))
 (func (export "f32_mul") (param f32 i32) (result f32) (local.get 0) (local.get 1) (f32.load) (f32.mul))
 (func (export "f32_div") (param f32 i32) (result f32) (local.get 0) (local.get 1) (f32.load) (f32.div))
 (func (export "f64_add") (param f64 i32) (result f64) (local.get 0) (local.get 1) (f64.load) (f64.add))
 (func (export "f64_sub") (param f64 i32) (result f64) (local.get 0) (local.get 1) (f64.load) (f64.sub))
 (func (export "f64_mul") (param f64 i32) (result f64) (local.get 0) (local.get 1) (f64.load) (f64.mul))
 (func (export "f64_div") (param f64 i32) (result f64) (local.get 0) (local.get 1) (f64.load) (f64.div))
 (data (i32.const 16) "\01\00\00\00\00\00\f8\7f\00\00\00\00\00\00\00\80\01\00\c0\7f\00\00\00\80")
 (func (export "dropped") (param f64 i32) (result i32) (drop (f64.mul (local.get 0) (f64.load (local.get 1)))) (i32.const 9))
 (func (export "shared") (param i32) (result f64) (local $x f64) (local.get 0) (f64.load) (local.tee $x) (local.get $x) (f64.mul))
 (func (export "left") (param i32 f64) (result f64) (local.get 0) (f64.load) (local.get 1) (f64.sub))
 (func (export "ordered") (param i32 f64) (result f64) (local $x f64) (local.get 0) (f64.load) (local.set $x) (i32.store (i32.const 40) (i32.const 99)) (local.get 1) (local.get $x) (f64.mul))
 (func (export "alias") (param f64) (result f64) (local $x f64) (f64.load (i32.const 0)) (local.set $x) (f64.store (i32.const 0) (f64.const 7)) (local.get 0) (local.get $x) (f64.mul))
 (func (export "get40") (result i32) (i32.load (i32.const 40)))
 (func (export "get0") (result f64) (f64.load (i32.const 0)))
)
(assert_return (invoke "f32_add" (f32.const 3) (i32.const 8)) (f32.const 5))
(assert_return (invoke "f32_sub" (f32.const 3) (i32.const 8)) (f32.const 1))
(assert_return (invoke "f32_mul" (f32.const 3) (i32.const 8)) (f32.const 6))
(assert_return (invoke "f32_div" (f32.const 3) (i32.const 8)) (f32.const 1.5))
(assert_return (invoke "f32_mul" (f32.const -0) (i32.const 8)) (f32.const -0))
(assert_return (invoke "f32_div" (f32.const inf) (i32.const 8)) (f32.const inf))
(assert_return (invoke "f32_mul" (f32.const nan) (i32.const 8)) (f32.const nan:arithmetic))
(assert_return (invoke "f32_div" (f32.const 0) (i32.const 64)) (f32.const nan:arithmetic))
(assert_trap (invoke "f32_add" (f32.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f32_add" (f32.const 0) (i32.const 65533)) "out of bounds memory access")
(assert_trap (invoke "f32_sub" (f32.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f32_sub" (f32.const 0) (i32.const 65533)) "out of bounds memory access")
(assert_trap (invoke "f32_mul" (f32.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f32_mul" (f32.const 0) (i32.const 65533)) "out of bounds memory access")
(assert_trap (invoke "f32_div" (f32.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f32_div" (f32.const 0) (i32.const 65533)) "out of bounds memory access")
(assert_return (invoke "f64_add" (f64.const 3) (i32.const 0)) (f64.const 5))
(assert_return (invoke "f64_sub" (f64.const 3) (i32.const 0)) (f64.const 1))
(assert_return (invoke "f64_mul" (f64.const 3) (i32.const 0)) (f64.const 6))
(assert_return (invoke "f64_div" (f64.const 3) (i32.const 0)) (f64.const 1.5))
(assert_return (invoke "f64_mul" (f64.const -0) (i32.const 0)) (f64.const -0))
(assert_return (invoke "f64_div" (f64.const inf) (i32.const 0)) (f64.const inf))
(assert_return (invoke "f64_mul" (f64.const nan) (i32.const 0)) (f64.const nan:arithmetic))
(assert_return (invoke "f64_div" (f64.const 0) (i32.const 64)) (f64.const nan:arithmetic))
(assert_trap (invoke "f64_add" (f64.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f64_add" (f64.const 0) (i32.const 65529)) "out of bounds memory access")
(assert_trap (invoke "f64_sub" (f64.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f64_sub" (f64.const 0) (i32.const 65529)) "out of bounds memory access")
(assert_trap (invoke "f64_mul" (f64.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f64_mul" (f64.const 0) (i32.const 65529)) "out of bounds memory access")
(assert_trap (invoke "f64_div" (f64.const 0) (i32.const -1)) "out of bounds memory access")
(assert_trap (invoke "f64_div" (f64.const 0) (i32.const 65529)) "out of bounds memory access")
(assert_return (invoke "shared" (i32.const 0)) (f64.const 4))
(assert_return (invoke "left" (i32.const 0) (f64.const 3)) (f64.const -1))
(assert_trap (invoke "ordered" (i32.const 65529) (f64.const 3)) "out of bounds memory access")
(assert_return (invoke "get40") (i32.const 0))
(assert_return (invoke "ordered" (i32.const 0) (f64.const 3)) (f64.const 6))
(assert_return (invoke "get40") (i32.const 99))
(assert_return (invoke "alias" (f64.const 3)) (f64.const 6))
(assert_return (invoke "get0") (f64.const 7))
(assert_return (invoke "dropped" (f64.const 3) (i32.const 0)) (i32.const 9))
(assert_trap (invoke "dropped" (f64.const 0) (i32.const 65529)) "out of bounds memory access")
(assert_return (invoke "f64_mul" (f64.const 3) (i32.const 16)) (f64.const nan:arithmetic))
(assert_return (invoke "f64_div" (f64.const 3) (i32.const 24)) (f64.const -inf))
(assert_return (invoke "f64_mul" (f64.const 3) (i32.const 24)) (f64.const -0))
(assert_return (invoke "f32_mul" (f32.const 3) (i32.const 32)) (f32.const nan:arithmetic))
(assert_return (invoke "f32_div" (f32.const 3) (i32.const 36)) (f32.const -inf))
(assert_return (invoke "f32_mul" (f32.const 3) (i32.const 36)) (f32.const -0))
