;; Lexicographic comparisons and changing local snapshot identities.
(module
(func (export "lt_u") (param i64 i64 i64 i64) (result i32) (select (i64.lt_u (local.get 0) (local.get 1)) (i64.lt_u (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "lt_u_ne") (param i64 i64 i64 i64) (result i32) (select (i64.lt_u (local.get 2) (local.get 3)) (i64.lt_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "le_u") (param i64 i64 i64 i64) (result i32) (select (i64.le_u (local.get 0) (local.get 1)) (i64.le_u (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "le_u_ne") (param i64 i64 i64 i64) (result i32) (select (i64.le_u (local.get 2) (local.get 3)) (i64.le_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "gt_u") (param i64 i64 i64 i64) (result i32) (select (i64.gt_u (local.get 0) (local.get 1)) (i64.gt_u (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "gt_u_ne") (param i64 i64 i64 i64) (result i32) (select (i64.gt_u (local.get 2) (local.get 3)) (i64.gt_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "ge_u") (param i64 i64 i64 i64) (result i32) (select (i64.ge_u (local.get 0) (local.get 1)) (i64.ge_u (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "ge_u_ne") (param i64 i64 i64 i64) (result i32) (select (i64.ge_u (local.get 2) (local.get 3)) (i64.ge_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "lt_s") (param i64 i64 i64 i64) (result i32) (select (i64.lt_u (local.get 0) (local.get 1)) (i64.lt_s (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "lt_s_ne") (param i64 i64 i64 i64) (result i32) (select (i64.lt_s (local.get 2) (local.get 3)) (i64.lt_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "le_s") (param i64 i64 i64 i64) (result i32) (select (i64.le_u (local.get 0) (local.get 1)) (i64.le_s (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "le_s_ne") (param i64 i64 i64 i64) (result i32) (select (i64.le_s (local.get 2) (local.get 3)) (i64.le_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "gt_s") (param i64 i64 i64 i64) (result i32) (select (i64.gt_u (local.get 0) (local.get 1)) (i64.gt_s (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "gt_s_ne") (param i64 i64 i64 i64) (result i32) (select (i64.gt_s (local.get 2) (local.get 3)) (i64.gt_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "ge_s") (param i64 i64 i64 i64) (result i32) (select (i64.ge_u (local.get 0) (local.get 1)) (i64.ge_s (local.get 2) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
(func (export "ge_s_ne") (param i64 i64 i64 i64) (result i32) (select (i64.ge_s (local.get 2) (local.get 3)) (i64.ge_u (local.get 0) (local.get 1)) (i64.ne (local.get 2) (local.get 3))))
(func (export "snapshot") (param i64 i64 i64 i64) (result i32) (local i64) (local.set 4 (local.get 2)) (local.set 2 (i64.add (local.get 2) (i64.const 1))) (select (i64.lt_u (local.get 0) (local.get 1)) (i64.lt_u (local.get 4) (local.get 3)) (i64.eq (local.get 4) (local.get 3))))
(func (export "changed") (param i64 i64 i64 i64) (result i32) (local i64) (local.set 4 (local.get 2)) (local.set 2 (i64.add (local.get 2) (i64.const 1))) (select (i64.lt_u (local.get 0) (local.get 1)) (i64.lt_u (local.get 4) (local.get 3)) (i64.eq (local.get 2) (local.get 3))))
)

(assert_return (invoke "lt_u" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_u" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "gt_u" (i64.const 0) (i64.const 1) (i64.const 2) (i64.const 1)) (i32.const 1))
(assert_return (invoke "ge_u" (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "lt_s" (i64.const 0) (i64.const 0) (i64.const -1) (i64.const 0)) (i32.const 1))
(assert_return (invoke "ge_s" (i64.const 0) (i64.const 0) (i64.const -1) (i64.const 0)) (i32.const 0))
(assert_return (invoke "le_s_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "snapshot" (i64.const 0) (i64.const 1) (i64.const 4) (i64.const 4)) (i32.const 1))
(assert_return (invoke "changed" (i64.const 0) (i64.const 0) (i64.const 4) (i64.const 5)) (i32.const 0))

;; Execute every comparison variant at low-limb borrow, equality, and signed overflow boundaries.
(assert_return (invoke "lt_u" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "lt_u" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "lt_u" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "lt_u_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "lt_u_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "lt_u_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "lt_s" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "lt_s" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "lt_s" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "lt_s_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "lt_s_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "lt_s_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "le_u" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_u" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_u" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "le_u_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_u_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_u_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "le_s" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_s" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_s" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "le_s_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_s_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "le_s_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "gt_u" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_u" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_u" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "gt_u_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_u_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_u_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "gt_s" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_s" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_s" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "gt_s_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_s_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "gt_s_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "ge_u" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "ge_u" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "ge_u" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "ge_u_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "ge_u_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "ge_u_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 1))
(assert_return (invoke "ge_s" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "ge_s" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "ge_s" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
(assert_return (invoke "ge_s_ne" (i64.const 0) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 0))
(assert_return (invoke "ge_s_ne" (i64.const 1) (i64.const 1) (i64.const 0) (i64.const 0)) (i32.const 1))
(assert_return (invoke "ge_s_ne" (i64.const 0) (i64.const 1) (i64.const -9223372036854775808) (i64.const 9223372036854775807)) (i32.const 0))
