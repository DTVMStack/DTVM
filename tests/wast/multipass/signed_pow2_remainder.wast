;; Signed remainder keeps the sign of the dividend, including for negative divisors.
(module
  (memory 1)
  (global $calls (mut i32) (i32.const 0))
  (func $dividend (result i64)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (i64.const -9))
  (func (export "pos32") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const 1024)))
  (func (export "neg32") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const -1024)))
  (func (export "min32") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const -2147483648)))
  (func (export "pos64") (param i64) (result i64)
    (i64.rem_s (local.get 0) (i64.const 1099511627776)))
  (func (export "neg64") (param i64) (result i64)
    (i64.rem_s (local.get 0) (i64.const -1099511627776)))
  (func (export "min64") (param i64) (result i64)
    (i64.rem_s (local.get 0) (i64.const -9223372036854775808)))
  (func (export "unit32") (result i32)
    (i32.rem_s (i32.const -2147483648) (i32.const -1)))
  (func (export "zero32") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const 0)))
  (func (export "zero64") (param i64) (result i64)
    (i64.rem_s (local.get 0) (i64.const 0)))
  (func (export "non_pow2_32") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const -7)))
  (func (export "dynamic64") (param i64 i64) (result i64)
    (i64.rem_s (local.get 0) (local.get 1)))
  (func (export "call64") (result i64)
    (global.set $calls (i32.const 0))
    (i64.add
      (i64.rem_s (call $dividend) (i64.const 8))
      (i64.extend_i32_u (global.get $calls))))
  (func (export "drop_call64") (result i32)
    (global.set $calls (i32.const 0))
    (drop (i64.rem_s (call $dividend) (i64.const -8)))
    (global.get $calls))
  (func (export "drop_load") (param i32)
    (drop (i32.rem_s (i32.load (local.get 0)) (i32.const -8))))
  (func (export "drop_div") (param i64)
    (drop (i64.rem_s (i64.div_s (i64.const 9) (local.get 0)) (i64.const 8))))
)

(assert_return (invoke "pos32" (i32.const -1025)) (i32.const -1))
(assert_return (invoke "pos32" (i32.const 1025)) (i32.const 1))
(assert_return (invoke "pos32" (i32.const -1024)) (i32.const 0))
(assert_return (invoke "pos32" (i32.const -2147483648)) (i32.const 0))
(assert_return (invoke "neg32" (i32.const -1023)) (i32.const -1023))
(assert_return (invoke "neg32" (i32.const 2147483647)) (i32.const 1023))
(assert_return (invoke "min32" (i32.const -2147483648)) (i32.const 0))
(assert_return (invoke "min32" (i32.const -2147483647)) (i32.const -2147483647))
(assert_return (invoke "min32" (i32.const 2147483647)) (i32.const 2147483647))
(assert_return (invoke "pos64" (i64.const -1099511627777)) (i64.const -1))
(assert_return (invoke "pos64" (i64.const 1099511627777)) (i64.const 1))
(assert_return (invoke "pos64" (i64.const -9223372036854775808)) (i64.const 0))
(assert_return (invoke "neg64" (i64.const -1099511627775)) (i64.const -1099511627775))
(assert_return (invoke "neg64" (i64.const 9223372036854775807)) (i64.const 1099511627775))
(assert_return (invoke "min64" (i64.const -9223372036854775808)) (i64.const 0))
(assert_return (invoke "min64" (i64.const -9223372036854775807)) (i64.const -9223372036854775807))
(assert_return (invoke "min64" (i64.const 9223372036854775807)) (i64.const 9223372036854775807))
(assert_return (invoke "unit32") (i32.const 0))
(assert_return (invoke "non_pow2_32" (i32.const -23)) (i32.const -2))
(assert_return (invoke "dynamic64" (i64.const -9223372036854775808) (i64.const -1)) (i64.const 0))
(assert_return (invoke "dynamic64" (i64.const -23) (i64.const 7)) (i64.const -2))
(assert_return (invoke "call64") (i64.const 0))
(assert_return (invoke "drop_call64") (i32.const 1))
(assert_trap (invoke "zero32" (i32.const 42)) "integer divide by zero")
(assert_trap (invoke "zero64" (i64.const -42)) "integer divide by zero")
(assert_trap (invoke "dynamic64" (i64.const 42) (i64.const 0)) "integer divide by zero")
(assert_trap (invoke "drop_load" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "drop_div" (i64.const 0)) "integer divide by zero")
