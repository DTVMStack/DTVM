;; Peephole pack A–D: semantic checks (positive folds and negative non-folds).

(module
  (func (export "ctz_eqz") (param i32) (result i32)
    (i32.eqz (i32.ctz (local.get 0))))
  (func (export "ctz_nez") (param i32) (result i32)
    (i32.ne (i32.ctz (local.get 0)) (i32.const 0)))
  (func (export "clz_eqz") (param i32) (result i32)
    (i32.eqz (i32.clz (local.get 0))))
  (func (export "clz_nez") (param i32) (result i32)
    (i32.ne (i32.clz (local.get 0)) (i32.const 0)))
  (func (export "ctz_eq4") (param i32) (result i32)
    (i32.eq (i32.ctz (local.get 0)) (i32.const 4)))
  (func (export "i64_ctz_eqz") (param i64) (result i32)
    (i64.eqz (i64.ctz (local.get 0))))
  (func (export "i64_clz_eqz") (param i64) (result i32)
    (i64.eqz (i64.clz (local.get 0))))

  (func (export "select_eq_true") (param i32) (result i32)
    (i32.eq (select (i32.const 7) (i32.const 3) (local.get 0)) (i32.const 7)))
  (func (export "select_eq_false") (param i32) (result i32)
    (i32.eq (select (i32.const 7) (i32.const 3) (local.get 0)) (i32.const 3)))
  (func (export "select_ne_true") (param i32) (result i32)
    (i32.ne (select (i32.const 7) (i32.const 3) (local.get 0)) (i32.const 7)))
  (func (export "select_eq_other") (param i32) (result i32)
    (i32.eq (select (i32.const 7) (i32.const 3) (local.get 0)) (i32.const 9)))

  (func (export "add0") (param i32) (result i32)
    (i32.add (local.get 0) (i32.const 0)))
  (func (export "sub0") (param i32) (result i32)
    (i32.sub (local.get 0) (i32.const 0)))
  (func (export "sub_self") (param i32) (result i32)
    (i32.sub (local.get 0) (local.get 0)))
  (func (export "mul1") (param i32) (result i32)
    (i32.mul (local.get 0) (i32.const 1)))
  (func (export "mul0") (param i32) (result i32)
    (i32.mul (local.get 0) (i32.const 0)))
  (func (export "and_x") (param i32) (result i32)
    (i32.and (local.get 0) (local.get 0)))
  (func (export "or0") (param i32) (result i32)
    (i32.or (local.get 0) (i32.const 0)))
  (func (export "xor_self") (param i32) (result i32)
    (i32.xor (local.get 0) (local.get 0)))
  (func (export "and0") (param i32) (result i32)
    (i32.and (local.get 0) (i32.const 0)))
  (func (export "shl0") (param i32) (result i32)
    (i32.shl (local.get 0) (i32.const 0)))
  (func (export "const_add") (result i32)
    (i32.add (i32.const 2) (i32.const 3)))
  (func (export "rem_u8") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 8)))
  (func (export "div_u8") (param i32) (result i32)
    (i32.div_u (local.get 0) (i32.const 8)))
  (func (export "rem_u1") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 1)))
  (func (export "div_u1") (param i32) (result i32)
    (i32.div_u (local.get 0) (i32.const 1)))
  (func (export "rem_u6") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 6)))
  (func (export "rem_s8") (param i32) (result i32)
    (i32.rem_s (local.get 0) (i32.const 8)))
  (func (export "rem_u0") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 0)))
  (func (export "div_u0") (param i32) (result i32)
    (i32.div_u (local.get 0) (i32.const 0)))
  (func (export "rem1_of_div0") (param i32) (result i32)
    (i32.rem_u (i32.div_u (local.get 0) (i32.const 0)) (i32.const 1)))
  (global $g (mut i32) (i32.const 0))
  (func $bump (param i32) (result i32)
    (global.set $g (i32.add (global.get $g) (i32.const 1)))
    (local.get 0))
  (func (export "rem1_of_call") (param i32) (result i32)
    (i32.rem_u (call $bump (local.get 0)) (i32.const 1)))
  (func (export "g") (result i32) (global.get $g))
  (memory 1)
  (func (export "rem1_of_oob_load") (param i32) (result i32)
    (i32.rem_u (i32.load (i32.const 0xFFFFFFFF)) (i32.const 1)))
  (func (export "rem1_of_trunc_s_nan") (result i32)
    (i32.rem_u (i32.trunc_f64_s (f64.const nan)) (i32.const 1)))
  (func (export "rem1_of_trunc_s_ovf") (result i32)
    (i32.rem_u (i32.trunc_f64_s (f64.const 1e300)) (i32.const 1)))
  (func (export "rem1_of_trunc_u_nan") (result i32)
    (i32.rem_u (i32.trunc_f64_u (f64.const nan)) (i32.const 1)))
  (func (export "rem_u_hi") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 0x80000000)))
  (func (export "i64_rem_u8") (param i64) (result i64)
    (i64.rem_u (local.get 0) (i64.const 8)))
  (func (export "i64_div_u8") (param i64) (result i64)
    (i64.div_u (local.get 0) (i64.const 8)))
  (func (export "i64_rem_u_wide") (param i64) (result i64)
    (i64.rem_u (local.get 0) (i64.const 0x100000000)))
  (func (export "i64_rem_u_hi") (param i64) (result i64)
    (i64.rem_u (local.get 0) (i64.const 0x8000000000000000)))
  (func (export "mul8") (param i32) (result i32)
    (i32.mul (local.get 0) (i32.const 8)))
  (func (export "add_reassoc") (param i32) (result i32)
    (i32.add (i32.add (local.get 0) (i32.const 10408)) (i32.const 8)))
  (func (export "sub8") (param i32) (result i32)
    (i32.sub (local.get 0) (i32.const 8)))

  (func (export "const_if_true") (param i32) (result i32)
    (if (result i32) (i32.const 1)
      (then (i32.add (local.get 0) (i32.const 1)))
      (else (i32.add (local.get 0) (i32.const 2)))))
  (func (export "const_if_false") (param i32) (result i32)
    (if (result i32) (i32.const 0)
      (then (i32.add (local.get 0) (i32.const 1)))
      (else (i32.add (local.get 0) (i32.const 2)))))
  ;; W2: const-0 br_if with no taken edge — fall through out of the loop.
  (func (export "const_br_if_fallthrough") (result i32)
    (local i32)
    (loop
      (local.set 0 (i32.const 1))
      (br_if 0 (i32.const 0)))
    (local.get 0))

  (func (export "count_lt") (param $n i32) (result i32)
    (local $i i32)
    (block $out
      (loop $L
        (local.get $i)
        (local.get $n)
        (i32.ge_s)
        (br_if $out)
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $L)))
    (local.get $i))
  (func (export "scale02") (param $n i32) (result f64)
    (local $i i32)
    (local $s f64)
    (block $out
      (loop $L
        (local.get $i)
        (local.get $n)
        (i32.ge_s)
        (br_if $out)
        (local.set $s
          (f64.add (local.get $s)
            (f64.mul (f64.const 0.2) (f64.convert_i32_s (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $L)))
    (local.get $s))
  (func (export "i32_slt0") (param i32) (result i32)
    (i32.lt_s (local.get 0) (i32.const 0)))
  (func (export "i32_ult0") (param i32) (result i32)
    (i32.lt_u (local.get 0) (i32.const 0)))
  (func (export "i32_slt_min") (param i32) (result i32)
    (i32.lt_s (local.get 0) (i32.const 0x80000000)))
  (func (export "i32_ult_min") (param i32) (result i32)
    (i32.lt_u (local.get 0) (i32.const 0x80000000)))
  (func (export "i64_slt0") (param i32) (result i32)
    (i64.lt_s (i64.extend_i32_s (local.get 0)) (i64.const 0)))
  (func (export "i64_ult0") (param i32) (result i32)
    (i64.lt_u (i64.extend_i32_s (local.get 0)) (i64.const 0)))
  (func (export "f64_gt_nan") (param i32) (result i32)
    (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const nan)))
  (func (export "f64_lt_nan") (param i32) (result i32)
    (f64.lt (f64.convert_i32_s (local.get 0)) (f64.const nan)))
  (func (export "f64_eq_nan") (param i32) (result i32)
    (f64.eq (f64.const nan) (f64.const nan)))
  (func (export "f64_ne_nan") (param i32) (result i32)
    (f64.ne (f64.const nan) (f64.const nan)))
  (func (export "f64_eq_signed_zero") (param i32) (result i32)
    (f64.eq (f64.const -0.0) (f64.const 0.0)))
  (func (export "f64_gt_inf") (param i32) (result i32)
    (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const inf)))
  (func (export "f64_gt_ninf") (param i32) (result i32)
    (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const -inf)))
  (func (export "if_slt") (param i32) (result i32)
    (if (result i32) (i32.lt_s (local.get 0) (i32.const 0))
      (then (i32.const 1))
      (else (i32.const 0))))
  (func (export "if_f64_gt_nan") (param i32) (result i32)
    (if (result i32) (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const nan))
      (then (i32.const 1))
      (else (i32.const 0))))
  ;; Asymmetric finite 2.0 vs param: OLT vs OGT must not both look like COND_A.
  (func (export "f64_gt_2") (param i32) (result i32)
    (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const 2.0)))
  (func (export "f64_lt_2") (param i32) (result i32)
    (f64.lt (f64.convert_i32_s (local.get 0)) (f64.const 2.0)))
  (func (export "f64_gt_nan_lhs") (param i32) (result i32)
    (f64.gt (f64.const nan) (f64.convert_i32_s (local.get 0))))
  (func (export "f64_gt_nan_rhs") (param i32) (result i32)
    (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const nan)))
  (func (export "f64_lt_nan_lhs") (param i32) (result i32)
    (f64.lt (f64.const nan) (f64.convert_i32_s (local.get 0))))
  (func (export "f64_lt_nan_rhs") (param i32) (result i32)
    (f64.lt (f64.convert_i32_s (local.get 0)) (f64.const nan)))
  (func (export "f32_gt_2") (param i32) (result i32)
    (f32.gt (f32.convert_i32_s (local.get 0)) (f32.const 2.0)))
  (func (export "f32_lt_2") (param i32) (result i32)
    (f32.lt (f32.convert_i32_s (local.get 0)) (f32.const 2.0)))
  (func (export "f32_gt_nan") (param i32) (result i32)
    (f32.gt (f32.convert_i32_s (local.get 0)) (f32.const nan)))
  (func (export "if_f64_gt_2") (param i32) (result i32)
    (if (result i32) (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const 2.0))
      (then (i32.const 7))
      (else (i32.const 3))))
  (func (export "if_f64_lt_2") (param i32) (result i32)
    (if (result i32) (f64.lt (f64.convert_i32_s (local.get 0)) (f64.const 2.0))
      (then (i32.const 7))
      (else (i32.const 3))))
  (func (export "if_f64_gt_nan_7_3") (param i32) (result i32)
    (if (result i32) (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const nan))
      (then (i32.const 7))
      (else (i32.const 3))))
  ;; if-without-else: true arm falls into the rejoin block (short diamond).
  ;; Result starts at 3 and is overwritten with 7 only on the true path.
  (func (export "if_f64_gt_2_short") (param i32) (result i32)
    (local $r i32)
    (local.set $r (i32.const 3))
    (if (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const 2.0))
      (then (local.set $r (i32.const 7))))
    (local.get $r))
  (func (export "if_f64_lt_2_short") (param i32) (result i32)
    (local $r i32)
    (local.set $r (i32.const 3))
    (if (f64.lt (f64.convert_i32_s (local.get 0)) (f64.const 2.0))
      (then (local.set $r (i32.const 7))))
    (local.get $r))
  (func (export "if_f64_gt_nan_short") (param i32) (result i32)
    (local $r i32)
    (local.set $r (i32.const 3))
    (if (f64.gt (f64.convert_i32_s (local.get 0)) (f64.const nan))
      (then (local.set $r (i32.const 7))))
    (local.get $r))
  (func (export "if_f64_lt_nan_lhs_short") (param i32) (result i32)
    (local $r i32)
    (local.set $r (i32.const 3))
    (if (f64.lt (f64.const nan) (f64.convert_i32_s (local.get 0)))
      (then (local.set $r (i32.const 7))))
    (local.get $r))
  (func (export "if_f32_gt_2_short") (param i32) (result i32)
    (local $r i32)
    (local.set $r (i32.const 3))
    (if (f32.gt (f32.convert_i32_s (local.get 0)) (f32.const 2.0))
      (then (local.set $r (i32.const 7))))
    (local.get $r))
)

(assert_return (invoke "ctz_eqz" (i32.const 0)) (i32.const 0))
(assert_return (invoke "ctz_eqz" (i32.const 1)) (i32.const 1))
(assert_return (invoke "ctz_eqz" (i32.const 2)) (i32.const 0))
(assert_return (invoke "ctz_eqz" (i32.const -1)) (i32.const 1))
(assert_return (invoke "ctz_eqz" (i32.const 16)) (i32.const 0))

(assert_return (invoke "ctz_nez" (i32.const 0)) (i32.const 1))
(assert_return (invoke "ctz_nez" (i32.const 1)) (i32.const 0))
(assert_return (invoke "ctz_nez" (i32.const 2)) (i32.const 1))

(assert_return (invoke "clz_eqz" (i32.const 0)) (i32.const 0))
(assert_return (invoke "clz_eqz" (i32.const 1)) (i32.const 0))
(assert_return (invoke "clz_eqz" (i32.const -1)) (i32.const 1))
(assert_return (invoke "clz_eqz" (i32.const 0x80000000)) (i32.const 1))
(assert_return (invoke "clz_eqz" (i32.const 0x7fffffff)) (i32.const 0))

(assert_return (invoke "clz_nez" (i32.const -1)) (i32.const 0))
(assert_return (invoke "clz_nez" (i32.const 1)) (i32.const 1))

(assert_return (invoke "ctz_eq4" (i32.const 16)) (i32.const 1))
(assert_return (invoke "ctz_eq4" (i32.const 1)) (i32.const 0))
(assert_return (invoke "ctz_eq4" (i32.const 0)) (i32.const 0))

(assert_return (invoke "i64_ctz_eqz" (i64.const 0)) (i32.const 0))
(assert_return (invoke "i64_ctz_eqz" (i64.const 1)) (i32.const 1))
(assert_return (invoke "i64_ctz_eqz" (i64.const 2)) (i32.const 0))
(assert_return (invoke "i64_clz_eqz" (i64.const -1)) (i32.const 1))
(assert_return (invoke "i64_clz_eqz" (i64.const 1)) (i32.const 0))

(assert_return (invoke "select_eq_true" (i32.const 0)) (i32.const 0))
(assert_return (invoke "select_eq_true" (i32.const 1)) (i32.const 1))
(assert_return (invoke "select_eq_true" (i32.const 99)) (i32.const 1))
(assert_return (invoke "select_eq_false" (i32.const 0)) (i32.const 1))
(assert_return (invoke "select_eq_false" (i32.const 1)) (i32.const 0))
(assert_return (invoke "select_ne_true" (i32.const 0)) (i32.const 1))
(assert_return (invoke "select_ne_true" (i32.const 1)) (i32.const 0))
(assert_return (invoke "select_eq_other" (i32.const 0)) (i32.const 0))
(assert_return (invoke "select_eq_other" (i32.const 1)) (i32.const 0))

(assert_return (invoke "add0" (i32.const 42)) (i32.const 42))
(assert_return (invoke "sub0" (i32.const 42)) (i32.const 42))
(assert_return (invoke "sub_self" (i32.const 42)) (i32.const 0))
(assert_return (invoke "mul1" (i32.const 42)) (i32.const 42))
(assert_return (invoke "mul0" (i32.const 42)) (i32.const 0))
(assert_return (invoke "and_x" (i32.const 42)) (i32.const 42))
(assert_return (invoke "or0" (i32.const 42)) (i32.const 42))
(assert_return (invoke "xor_self" (i32.const 42)) (i32.const 0))
(assert_return (invoke "and0" (i32.const 42)) (i32.const 0))
(assert_return (invoke "shl0" (i32.const 42)) (i32.const 42))
(assert_return (invoke "const_add") (i32.const 5))
(assert_return (invoke "mul8" (i32.const 3)) (i32.const 24))
(assert_return (invoke "add_reassoc" (i32.const 1)) (i32.const 10417))
(assert_return (invoke "sub8" (i32.const 20)) (i32.const 12))
(assert_return (invoke "sub8" (i32.const 0)) (i32.const -8))

(assert_return (invoke "rem_u8" (i32.const 0)) (i32.const 0))
(assert_return (invoke "rem_u8" (i32.const 7)) (i32.const 7))
(assert_return (invoke "rem_u8" (i32.const 8)) (i32.const 0))
(assert_return (invoke "rem_u8" (i32.const 9)) (i32.const 1))
(assert_return (invoke "rem_u8" (i32.const -1)) (i32.const 7))
(assert_return (invoke "div_u8" (i32.const 0)) (i32.const 0))
(assert_return (invoke "div_u8" (i32.const 7)) (i32.const 0))
(assert_return (invoke "div_u8" (i32.const 8)) (i32.const 1))
(assert_return (invoke "div_u8" (i32.const 9)) (i32.const 1))
(assert_return (invoke "div_u8" (i32.const -1)) (i32.const 536870911))
(assert_return (invoke "rem_u1" (i32.const 42)) (i32.const 0))
(assert_return (invoke "div_u1" (i32.const 42)) (i32.const 42))
(assert_return (invoke "rem_u6" (i32.const 10)) (i32.const 4))
(assert_return (invoke "rem_s8" (i32.const -5)) (i32.const -5))
(assert_trap (invoke "rem_u0" (i32.const 1)) "integer divide by zero")
(assert_trap (invoke "div_u0" (i32.const 1)) "integer divide by zero")
(assert_trap (invoke "rem1_of_div0" (i32.const 1)) "integer divide by zero")
(assert_return (invoke "rem1_of_call" (i32.const 42)) (i32.const 0))
(assert_return (invoke "g") (i32.const 1))
(assert_trap (invoke "rem1_of_oob_load" (i32.const 0)) "out of bounds memory access")
(assert_trap (invoke "rem1_of_trunc_s_nan") "invalid conversion to integer")
(assert_trap (invoke "rem1_of_trunc_s_ovf") "integer overflow")
(assert_trap (invoke "rem1_of_trunc_u_nan") "invalid conversion to integer")
(assert_return (invoke "rem_u_hi" (i32.const 0x80000001)) (i32.const 1))
(assert_return (invoke "i64_rem_u8" (i64.const 9)) (i64.const 1))
(assert_return (invoke "i64_rem_u8" (i64.const -1)) (i64.const 7))
(assert_return (invoke "i64_div_u8" (i64.const 9)) (i64.const 1))
(assert_return (invoke "i64_div_u8" (i64.const -1)) (i64.const 2305843009213693951))
(assert_return (invoke "i64_rem_u_wide" (i64.const 0x100000001)) (i64.const 1))
(assert_return (invoke "i64_rem_u_hi" (i64.const 0x8000000000000001)) (i64.const 1))

(assert_return (invoke "const_if_true" (i32.const 10)) (i32.const 11))
(assert_return (invoke "const_if_false" (i32.const 10)) (i32.const 12))
(assert_return (invoke "const_br_if_fallthrough") (i32.const 1))
(assert_return (invoke "count_lt" (i32.const 0)) (i32.const 0))
(assert_return (invoke "count_lt" (i32.const 1)) (i32.const 1))
(assert_return (invoke "count_lt" (i32.const 5)) (i32.const 5))
(assert_return (invoke "scale02" (i32.const 0)) (f64.const 0.0))
(assert_return (invoke "scale02" (i32.const 5)) (f64.const 2.0))
(assert_return (invoke "i32_slt0" (i32.const -1)) (i32.const 1))
(assert_return (invoke "i32_slt0" (i32.const 0)) (i32.const 0))
(assert_return (invoke "i32_ult0" (i32.const -1)) (i32.const 0))
(assert_return (invoke "i32_slt_min" (i32.const 0)) (i32.const 0))
(assert_return (invoke "i32_ult_min" (i32.const 0)) (i32.const 1))
(assert_return (invoke "i32_ult_min" (i32.const -1)) (i32.const 0))
(assert_return (invoke "i64_slt0" (i32.const -1)) (i32.const 1))
(assert_return (invoke "i64_ult0" (i32.const -1)) (i32.const 0))
(assert_return (invoke "f64_gt_nan" (i32.const 1)) (i32.const 0))
(assert_return (invoke "f64_lt_nan" (i32.const 1)) (i32.const 0))
(assert_return (invoke "f64_eq_nan" (i32.const 0)) (i32.const 0))
(assert_return (invoke "f64_ne_nan" (i32.const 0)) (i32.const 1))
(assert_return (invoke "f64_eq_signed_zero" (i32.const 0)) (i32.const 1))
(assert_return (invoke "f64_gt_inf" (i32.const 1)) (i32.const 0))
(assert_return (invoke "f64_gt_ninf" (i32.const 0)) (i32.const 1))
(assert_return (invoke "if_slt" (i32.const -1)) (i32.const 1))
(assert_return (invoke "if_slt" (i32.const 1)) (i32.const 0))
