;; Shared module for mirPeepholeTests (e2e, concurrent, microbench).
(module
  (func (export "ctz_eqz") (param i32) (result i32)
    (i32.eqz (i32.ctz (local.get 0))))
  (func (export "clz_eqz") (param i32) (result i32)
    (i32.eqz (i32.clz (local.get 0))))
  (func (export "ctz_eq4") (param i32) (result i32)
    (i32.eq (i32.ctz (local.get 0)) (i32.const 4)))
  (func (export "select_eq_true") (param i32) (result i32)
    (i32.eq (select (i32.const 7) (i32.const 3) (local.get 0)) (i32.const 7)))
  (func (export "add0") (param i32) (result i32)
    (i32.add (local.get 0) (i32.const 0)))
  (func (export "const_if_true") (param i32) (result i32)
    (if (result i32) (i32.const 1)
      (then (i32.add (local.get 0) (i32.const 1)))
      (else (i32.add (local.get 0) (i32.const 2)))))
  (func (export "const_if_false") (param i32) (result i32)
    (if (result i32) (i32.const 0)
      (then (i32.add (local.get 0) (i32.const 1)))
      (else (i32.add (local.get 0) (i32.const 2)))))
  (func (export "bench_ctz_eqz") (param i32) (result i32)
    (local i32 i32)
    (local.set 1 (local.get 0))
    (loop
      (local.set 2 (i32.add (local.get 2) (i32.eqz (i32.ctz (local.get 2)))))
      (local.set 1 (i32.sub (local.get 1) (i32.const 1)))
      (br_if 0 (local.get 1)))
    (local.get 2))
  (func (export "bench_select") (param i32) (result i32)
    (local i32 i32)
    (local.set 1 (local.get 0))
    (loop
      (local.set 2 (i32.add (local.get 2)
        (i32.eq (select (i32.const 1) (i32.const 0) (i32.and (local.get 2) (i32.const 1))) (i32.const 1))))
      (local.set 1 (i32.sub (local.get 1) (i32.const 1)))
      (br_if 0 (local.get 1)))
    (local.get 2))
  (func (export "bench_algebra") (param i32) (result i32)
    (local i32 i32)
    (local.set 1 (local.get 0))
    (loop
      (local.set 2 (i32.add (local.get 2)
        (i32.xor (i32.and (i32.add (local.get 2) (i32.const 0)) (local.get 2)) (i32.const 0))))
      (local.set 1 (i32.sub (local.get 1) (i32.const 1)))
      (br_if 0 (local.get 1)))
    (local.get 2))
  (func (export "bench_const_br") (param i32) (result i32)
    (local i32 i32)
    (local.set 1 (local.get 0))
    (loop
      (local.set 2
        (if (result i32) (i32.const 1)
          (then (i32.add (local.get 2) (i32.const 1)))
          (else (i32.add (local.get 2) (i32.const 2)))))
      (local.set 1 (i32.sub (local.get 1) (i32.const 1)))
      (br_if 0 (local.get 1)))
    (local.get 2))
  (func (export "bench_mixed") (param i32) (result i32)
    (local i32 i32)
    (local.set 1 (local.get 0))
    (loop
      (local.set 2 (i32.add (local.get 2) (i32.eqz (i32.ctz (local.get 2)))))
      (local.set 2 (i32.add (local.get 2) (i32.eqz (i32.clz (local.get 2)))))
      (local.set 2 (i32.add (local.get 2)
        (i32.eq (select (i32.const 1) (i32.const 0)
                        (i32.and (local.get 2) (i32.const 1)))
                (i32.const 1))))
      (local.set 2 (i32.add (local.get 2)
        (i32.xor (i32.and (i32.add (local.get 2) (i32.const 0)) (local.get 2))
                 (i32.const 0))))
      (local.set 2
        (if (result i32) (i32.const 1)
          (then (i32.add (local.get 2) (i32.const 1)))
          (else (i32.add (local.get 2) (i32.const 2)))))
      (local.set 1 (i32.sub (local.get 1) (i32.const 1)))
      (br_if 0 (local.get 1)))
    (local.get 2))
  ;; Larger LCG + bit-test kernel (A/B/C/D in one loop).
  (func (export "bitmix") (param i32) (result i32)
    (local $n i32) (local $x i32) (local $acc i32)
    (local.set $n (local.get 0))
    (local.set $x (i32.const 1))
    (loop $L
      (local.set $x (i32.add (i32.mul (local.get $x) (i32.const 1664525))
                             (i32.const 1013904223)))
      (if (i32.eqz (i32.ctz (local.get $x)))
        (then (local.set $acc (i32.add (local.get $acc) (i32.const 1)))))
      (if (i32.eqz (i32.clz (local.get $x)))
        (then (local.set $acc (i32.add (local.get $acc) (i32.const 1)))))
      (local.set $acc (i32.add (local.get $acc)
        (i32.eq (select (i32.const 3) (i32.const 5)
                        (i32.and (local.get $x) (i32.const 1)))
                (i32.const 3))))
      (local.set $acc (i32.add (local.get $acc)
                               (i32.add (local.get $x) (i32.const 0))))
      (if (i32.const 1)
        (then (local.set $acc (i32.or (local.get $acc) (i32.const 0))))
        (else (local.set $acc (i32.add (local.get $acc) (i32.const 99)))))
      (local.set $n (i32.sub (local.get $n) (i32.const 1)))
      (br_if $L (local.get $n)))
    (local.get $acc))
  (func (export "f0") (param i32) (result i32) (i32.eqz (i32.ctz (local.get 0))))
  (func (export "f1") (param i32) (result i32) (i32.eqz (i32.clz (local.get 0))))
  (func (export "f2") (param i32) (result i32) (i32.eq (select (i32.const 1) (i32.const 0) (local.get 0)) (i32.const 1)))
  (func (export "f3") (param i32) (result i32) (i32.add (local.get 0) (i32.const 0)))
  (func (export "f4") (param i32) (result i32) (i32.and (local.get 0) (local.get 0)))
  (func (export "f5") (param i32) (result i32) (i32.or (local.get 0) (i32.const 0)))
  (func (export "f6") (param i32) (result i32) (i32.xor (local.get 0) (i32.const 0)))
  (func (export "f7") (param i32) (result i32) (i32.mul (local.get 0) (i32.const 1)))
  (func (export "f8") (param i32) (result i32)
    (if (result i32) (i32.const 1) (then (local.get 0)) (else (i32.const 0))))
  (func (export "f9") (param i32) (result i32)
    (if (result i32) (i32.const 0) (then (i32.const 0)) (else (local.get 0))))
  (func (export "f10") (param i32) (result i32) (i32.shl (local.get 0) (i32.const 0)))
  (func (export "f11") (param i32) (result i32) (i32.sub (local.get 0) (i32.const 0)))
  (func (export "f12") (param i32) (result i32) (i32.eqz (i32.ctz (i32.or (local.get 0) (i32.const 1)))))
  (func (export "f13") (param i32) (result i32) (i32.eqz (i32.clz (i32.or (local.get 0) (i32.const 0x80000000)))))
  (func (export "f14") (param i32) (result i32) (i32.eq (i32.ctz (local.get 0)) (i32.const 4)))
  (func (export "f15") (param i32) (result i32) (i32.add (i32.const 2) (i32.const 3)))
  (func (export "const_br_if_fallthrough") (param i32) (result i32)
    (local i32)
    (loop
      (local.set 1 (i32.const 1))
      (br_if 0 (i32.const 0)))
    (local.get 1))
)
