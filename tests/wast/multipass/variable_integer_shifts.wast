(module
  (func (export "left32") (param i32 i32) (result i32)
    (i32.shl (local.get 0) (local.get 1)))
  (func (export "arithmetic32") (param i32 i32) (result i32)
    (i32.shr_s (local.get 0) (local.get 1)))
  (func (export "logical32") (param i32 i32) (result i32)
    (i32.shr_u (local.get 0) (local.get 1)))
  (func (export "left64") (param i64 i64) (result i64)
    (i64.shl (local.get 0) (local.get 1)))
  (func (export "arithmetic64") (param i64 i64) (result i64)
    (i64.shr_s (local.get 0) (local.get 1)))
  (func (export "logical64") (param i64 i64) (result i64)
    (i64.shr_u (local.get 0) (local.get 1)))
  (func (export "shared64") (param i64 i64) (result i64)
    (i64.add
      (i64.xor (i64.shl (local.get 0) (local.get 1))
               (i64.shr_u (local.get 0) (local.get 1)))
      (i64.add (local.get 0) (local.get 1))))
  (func (export "rotate32") (param i32 i32) (result i32)
    (i32.rotl (local.get 0) (local.get 1))))

(assert_return (invoke "left32" (i32.const 1) (i32.const -1)) (i32.const 0x80000000))
(assert_return (invoke "left32" (i32.const 1) (i32.const 33)) (i32.const 2))
(assert_return (invoke "arithmetic32" (i32.const 0x80000000) (i32.const 0x80000021)) (i32.const 0xc0000000))
(assert_return (invoke "logical32" (i32.const 0x80000000) (i32.const 32)) (i32.const 0x80000000))
(assert_return (invoke "logical32" (i32.const 0x80000000) (i32.const 33)) (i32.const 0x40000000))
(assert_return (invoke "left64" (i64.const 1) (i64.const -63)) (i64.const 2))
(assert_return (invoke "left64" (i64.const 1) (i64.const 0xffffffffffffffff)) (i64.const 0x8000000000000000))
(assert_return (invoke "arithmetic64" (i64.const 0x8000000000000000) (i64.const 64)) (i64.const 0x8000000000000000))
(assert_return (invoke "arithmetic64" (i64.const 0x8000000000000000) (i64.const 0x8000000000000001)) (i64.const 0xc000000000000000))
(assert_return (invoke "logical64" (i64.const 0x8000000000000000) (i64.const 127)) (i64.const 1))
(assert_return (invoke "shared64" (i64.const 0x8123456789abcdef) (i64.const 65)) (i64.const 0xc3fa6de4612e4b59))
(assert_return (invoke "rotate32" (i32.const 0x80000000) (i32.const 33)) (i32.const 1))
