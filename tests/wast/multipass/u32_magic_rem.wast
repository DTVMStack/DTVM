;; Exact unsigned i32 constant remainder; preserve single evaluation and traps.
(module
  (memory 1)
  (global $calls (mut i32) (i32.const 0))
  (func $next (result i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (i32.const 22))
  (func (export "rem3") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 3)))
  (func (export "rem7") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 7)))
  (func (export "rem10") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 10)))
  (func (export "rem20") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 20)))
  (func (export "rem1900") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 1900)))
  (func (export "rem2100") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 2100)))
  (func (export "rem65521") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 65521)))
  (func (export "rem4294967295") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 4294967295)))
  (func (export "rem2147483649") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 2147483649)))
  (func (export "rem8") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 8)))
  (func (export "rem1") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 1)))
  (func (export "call_once") (result i32)
    (global.set $calls (i32.const 0))
    (if (i32.ne (i32.rem_u (call $next) (i32.const 7)) (i32.const 1))
      (then (unreachable)))
    (global.get $calls))
  (func (export "rem0") (param i32) (result i32)
    (i32.rem_u (local.get 0) (i32.const 0)))
  (func (export "nested_div0") (param i32) (result i32)
    (i32.rem_u (i32.div_u (i32.const 1) (local.get 0)) (i32.const 7)))
  (func (export "load_rem") (param i32) (result i32)
    (i32.rem_u (i32.load (local.get 0)) (i32.const 10)))
  (func (export "nan_rem") (param f64) (result i32)
    (i32.rem_u (i32.trunc_f64_u (local.get 0)) (i32.const 20)))
  (func (export "drop_call_once") (result i32)
    (global.set $calls (i32.const 0))
    (drop (i32.rem_u (call $next) (i32.const 7)))
    (global.get $calls))
  (func (export "drop_div0") (param i32)
    (drop (i32.rem_u (i32.div_u (i32.const 1) (local.get 0)) (i32.const 7))))
  (func (export "drop_load") (param i32)
    (drop (i32.rem_u (i32.load (local.get 0)) (i32.const 10))))
  (func (export "drop_nan") (param f64)
    (drop (i32.rem_u (i32.trunc_f64_u (local.get 0)) (i32.const 20))))
  (func (export "drop_zero")
    (drop (i32.rem_u (i32.const 1) (i32.const 0))))
)
