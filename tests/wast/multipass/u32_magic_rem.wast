(assert_trap (invoke "drop_load" (i32.const 65536)) "out of bounds memory access")
(assert_trap (invoke "drop_nan" (f64.const nan)) "invalid conversion to integer")
(assert_trap (invoke "drop_zero") "integer divide by zero")
