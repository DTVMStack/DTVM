(module
 (func $kernel (param $n i32)
  (param $a i64) (param $b i64) (param $c i64) (param $d i64)
  (param $e i64) (param $f i64) (param $g i64) (param $h i64)
  (param $p f64) (param $q f64) (param $r f64) (param $s f64)
  (param $t f64) (param $u f64) (param $v f64) (param $w f64) (param $z f64)
  (result f64) (local $i i32) (local $x i64) (local $sum i64)
  (local.set $x (i64.const 1))
  (loop $again
   (local.set $x (i64.and (i64.add (i64.mul (local.get $x) (i64.const 1664525)) (i64.const 1013904223)) (i64.const 1023)))
   (local.set $sum (i64.add (local.get $sum) (local.get $x)))
   (br_if $again (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
  (f64.add
   (f64.convert_i64_u (i64.add (local.get $sum)
    (i64.add (i64.add (i64.add (local.get $a) (local.get $b)) (i64.add (local.get $c) (local.get $d)))
             (i64.add (i64.add (local.get $e) (local.get $f)) (i64.add (local.get $g) (local.get $h))))))
   (f64.add (f64.add (f64.add (local.get $p) (local.get $q)) (f64.add (local.get $r) (local.get $s)))
    (f64.add (f64.add (local.get $t) (local.get $u)) (f64.add (local.get $v) (f64.add (local.get $w) (local.get $z)))))))
 (func $simple (param $n i32) (result i64) (local $i i32) (local $s i64) (local $x i64)
  (local.set $x (i64.const 1))
  (loop $again
   (local.set $x (i64.and (i64.add (i64.mul (local.get $x) (i64.const 1664525)) (i64.const 1013904223)) (i64.const 1023)))
   (local.set $s (i64.add (local.get $s) (local.get $x)))
   (br_if $again (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
  (local.get $s))
 (func (export "repeat") (param $count i32) (param $trips i32) (result f64) (local $i i32) (local $total f64)
  (loop $again
   (local.set $total (f64.add (local.get $total)
    (call $kernel (local.get $trips)
     (i64.const 1) (i64.const 2) (i64.const 3) (i64.const 4)
     (i64.const 5) (i64.const 6) (i64.const 7) (i64.const 8)
     (f64.const 0.25) (f64.const 0.5) (f64.const 0.75) (f64.const 1)
     (f64.const 1.25) (f64.const 1.5) (f64.const 1.75) (f64.const 2) (f64.const 2.25))))
   (br_if $again (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $count))))
  (local.get $total))
 (func (export "repeat_simple") (param $count i32) (param $trips i32) (result i64) (local $i i32) (local $total i64)
  (loop $again
   (local.set $total (i64.add (local.get $total) (call $simple (local.get $trips))))
   (br_if $again (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $count))))
  (local.get $total))
)
