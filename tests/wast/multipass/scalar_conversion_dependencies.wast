;; Scalar GPR-to-XMM conversions may clear dead upper lanes, but must preserve
;; integer inputs, neighboring live FP values, rounding and control flow.
(module
 (func (export "s32_f32") (param i32) (result f32) (f32.convert_i32_s (local.get 0)))
 (func (export "s32_f64") (param i32) (result f64) (f64.convert_i32_s (local.get 0)))
 (func (export "u32_f32") (param i32) (result f32) (f32.convert_i32_u (local.get 0)))
 (func (export "u32_f64") (param i32) (result f64) (f64.convert_i32_u (local.get 0)))
 (func (export "s64_f32") (param i64) (result f32) (f32.convert_i64_s (local.get 0)))
 (func (export "s64_f64") (param i64) (result f64) (f64.convert_i64_s (local.get 0)))
 (func (export "u64_f32") (param i64) (result f32) (f32.convert_i64_u (local.get 0)))
 (func (export "u64_f64") (param i64) (result f64) (f64.convert_i64_u (local.get 0)))
 (func (export "live_fp") (param f64 f64 i32) (result f64)
  (f64.add (f64.mul (local.get 0) (local.get 1)) (f64.convert_i32_s (local.get 2))))
 (func (export "loop") (param $n i32) (result f64)
  (local $i i32) (local $sum f64)
  (loop $again
   (local.set $sum (f64.add (local.get $sum)
    (f64.div (f64.convert_i32_s (local.get $i)) (f64.const 4))))
   (br_if $again (i32.lt_u
    (local.tee $i (i32.add (local.get $i) (i32.const 1))) (local.get $n))))
  (local.get $sum))
)
(assert_return (invoke "s32_f32" (i32.const -2147483648)) (f32.const -0x1p31))
(assert_return (invoke "s32_f32" (i32.const 2147483647)) (f32.const 0x1p31))
(assert_return (invoke "s32_f64" (i32.const -2147483648)) (f64.const -2147483648))
(assert_return (invoke "s32_f64" (i32.const 2147483647)) (f64.const 2147483647))
(assert_return (invoke "u32_f32" (i32.const -1)) (f32.const 0x1p32))
(assert_return (invoke "u32_f64" (i32.const -1)) (f64.const 4294967295))
(assert_return (invoke "s64_f32" (i64.const -9223372036854775808)) (f32.const -0x1p63))
(assert_return (invoke "s64_f32" (i64.const 9223372036854775807)) (f32.const 0x1p63))
(assert_return (invoke "s64_f64" (i64.const -9223372036854775808)) (f64.const -0x1p63))
(assert_return (invoke "s64_f64" (i64.const 9223372036854775807)) (f64.const 0x1p63))
(assert_return (invoke "u64_f32" (i64.const -1)) (f32.const 0x1p64))
(assert_return (invoke "u64_f32" (i64.const 9223372036854775807)) (f32.const 0x1p63))
(assert_return (invoke "u64_f64" (i64.const -1)) (f64.const 0x1p64))
(assert_return (invoke "u64_f64" (i64.const 9223372036854775807)) (f64.const 0x1p63))
(assert_return (invoke "live_fp" (f64.const 1.5) (f64.const 4) (i32.const -2)) (f64.const 4))
(assert_return (invoke "live_fp" (f64.const -0) (f64.const 4) (i32.const 0)) (f64.const 0))
(assert_return (invoke "loop" (i32.const 100)) (f64.const 1237.5))
(assert_return (invoke "loop" (i32.const 1)) (f64.const 0))
