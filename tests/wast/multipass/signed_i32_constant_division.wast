(module
  (memory 1)
  (global $calls (mut i32) (i32.const 0))
  (func $dividend (result i32)
    (global.set $calls (i32.add (global.get $calls) (i32.const 1)))
    (i32.const -23))
  (func (export "by3") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const 3)))
  (func (export "by_minus7") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const -7)))
  (func (export "by_minus12") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const -12)))
  (func (export "by_max") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const 2147483647)))
  (func (export "by_min") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const -2147483648)))
  (func (export "by_minus1") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const -1)))
  (func (export "by_zero") (param i32) (result i32)
    (i32.div_s (local.get 0) (i32.const 0)))
  (func (export "call_once") (result i32)
    (global.set $calls (i32.const 0))
    (i32.add (i32.div_s (call $dividend) (i32.const -7)) (global.get $calls)))
  (func (export "drop_load") (param i32)
    (drop (i32.div_s (i32.load (local.get 0)) (i32.const 7)))))

(assert_return (invoke "by3" (i32.const -2147483648)) (i32.const -715827882))
(assert_return (invoke "by3" (i32.const 2147483647)) (i32.const 715827882))
(assert_return (invoke "by3" (i32.const -2)) (i32.const 0))
(assert_return (invoke "by_minus7" (i32.const -2147483648)) (i32.const 306783378))
(assert_return (invoke "by_minus7" (i32.const 15)) (i32.const -2))
(assert_return (invoke "by_minus7" (i32.const 6)) (i32.const 0))
(assert_return (invoke "by_minus12" (i32.const -49)) (i32.const 4))
(assert_return (invoke "by_max" (i32.const -2147483648)) (i32.const -1))
(assert_return (invoke "by_max" (i32.const 2147483646)) (i32.const 0))
(assert_return (invoke "by_min" (i32.const -2147483648)) (i32.const 1))
(assert_return (invoke "by_minus1" (i32.const -5)) (i32.const 5))
(assert_return (invoke "call_once") (i32.const 4))
(assert_trap (invoke "by_minus1" (i32.const -2147483648)) "integer overflow")
(assert_trap (invoke "by_zero" (i32.const 42)) "integer divide by zero")
(assert_trap (invoke "drop_load" (i32.const 65536)) "out of bounds memory access")
