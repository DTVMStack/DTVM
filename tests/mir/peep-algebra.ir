; RUN: ircompiler %s -f 0 --args 42 | FileCheck %s -check-prefix ADD0
; RUN: ircompiler %s -f 1 --args 42 | FileCheck %s -check-prefix SUBS
; RUN: ircompiler %s -f 2 --args 42 | FileCheck %s -check-prefix MUL0
; RUN: ircompiler %s -f 3 --args 42 | FileCheck %s -check-prefix XOR
; RUN: ircompiler %s -f 4 --args 0 | FileCheck %s -check-prefix CADD

; ADD0: 0x2a:i32
; SUBS: 0x0:i32
; MUL0: 0x0:i32
; XOR: 0x0:i32
; CADD: 0x5:i32

func %0 (i32) -> i32 {
    var $1 i32
@0:
    $1 = add ($0, const.i32 0)
    return $1
}

func %1 (i32) -> i32 {
    var $1 i32
@0:
    $1 = sub ($0, $0)
    return $1
}

func %2 (i32) -> i32 {
    var $1 i32
@0:
    $1 = mul ($0, const.i32 0)
    return $1
}

func %3 (i32) -> i32 {
    var $1 i32
@0:
    $1 = xor ($0, $0)
    return $1
}

func %4 () -> i32 {
    var $0 i32
@0:
    $0 = add (const.i32 2, const.i32 3)
    return $0
}
