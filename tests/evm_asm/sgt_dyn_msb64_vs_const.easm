// dyn(0x9000000000000000) >s const 0x8000000000000000 -> 1. Both are
// non-negative signed-256 (only limb0 set), so an UNSIGNED limb0 compare gives
// 0x9000... > 0x8000... = 1. Push const RHS first, dynamic LHS on top.
PUSH8 0x8000000000000000
PUSH32 0x0000000000000000000000000000000000000000000000009000000000000000
PUSH1 0x00
MSTORE
PUSH1 0x00
MLOAD
SGT
PUSH1 0x00
MSTORE
PUSH1 0x20
PUSH1 0x00
RETURN
