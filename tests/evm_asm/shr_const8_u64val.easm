// (dyn AND 0xFFFFFFFFFFFFFFFF) >> 8
// the AND mask makes the value provably U64, so only limb0 is live and the
// SHR const path prunes the carry-in from limb1
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
PUSH1 0x00
MSTORE
PUSH1 0x00
MLOAD
PUSH8 0xFFFFFFFFFFFFFFFF
AND
PUSH1 0x08
SHR
PUSH1 0x00
MSTORE
PUSH1 0x20
PUSH1 0x00
RETURN
