// (dyn AND 0xFFFFFFFFFFFFFFFF) << 200
// the AND mask gives the value a provable U64 range, so the SHL const path
// (CompShift=3, ShiftMod=8) prunes all source limbs except limb0
PUSH32 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF
PUSH1 0x00
MSTORE
PUSH1 0x00
MLOAD
PUSH8 0xFFFFFFFFFFFFFFFF
AND
PUSH1 0xC8
SHL
PUSH1 0x00
MSTORE
PUSH1 0x20
PUSH1 0x00
RETURN
