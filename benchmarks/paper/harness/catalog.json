{
  "schema_version": "phase15-v1",
  "notes": {
    "fair_same_wasm": "DTVM and Wasmtime execute the identical .wasm with equivalent entry/args/dir/stdin. Wasmtime module cache is disabled.",
    "dtvm_hostapi_only": "DTVM overflow path imports env::checked_i64_*; Wasmtime cannot run that module. Not a same-wasm comparison.",
    "different_wasm": "Wasmtime overflow uses emscripten wasm with opcode 0xfc / bulk-memory that DTVM cannot load. Paper overflow table is different-wasm by construction.",
    "zuk_standin": "Paper WAPM row 'zuk' is reproduced with fortune.wasm (same as scripts/run_lazy_20.sh).",
    "scales": "fib/overflow 'dev' matches Phase 1.5 (1e6 iters). 'paper' matches REPRODUCE_fib_overflow_5way.md (500M fib / 100M overflow)."
  },
  "polybench": {
    "dir": "benchmarks/polybenchc",
    "kind": "wasi-main",
    "fairness": "same-wasm",
    "skip_interp": [
      "2mm",
      "3mm",
      "adi",
      "correlation",
      "covariance",
      "deriche",
      "doitgen",
      "fdtd-2d",
      "floyd-warshall",
      "gemm",
      "gramschmidt",
      "heat-3d",
      "jacobi-2d",
      "lu",
      "ludcmp",
      "nussinov",
      "seidel-2d",
      "symm",
      "syr2k",
      "syrk",
      "trmm"
    ]
  },
