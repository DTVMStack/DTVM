@@ -0,0 +1,34 @@
+//! WAPM paper-style Time-to-First-Invocation reporting on stdout.
+//!
+//! Enabled with the `ttfi-report` crate feature (on by default in dtvm paper builds).
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::time::Duration;
+
+static EXEC_COUNT: AtomicUsize = AtomicUsize::new(0);
+
+/// Reset per-process execution counter (optional; new process starts at 0).
+pub fn reset_execution_count() {
+    EXEC_COUNT.store(0, Ordering::Relaxed);
+}
+
+pub fn report_mmap(elapsed: Duration) {
+    let us = elapsed.as_micros();
+    println!(
+        "Creating mmap for file took: {:.3}µs",
+        us as f64 / 1000.0
+    );
+    println!("mmap success:");
+}
+
+pub fn report_compile_time(elapsed: Duration) {
+    let us = elapsed.as_micros();
+    let ms = us / 1000;
+    println!("Total compilation time: {} ms ({} µs)", ms, us);
+}
+
+pub fn report_execution(elapsed: Duration) {
+    let n = EXEC_COUNT.fetch_add(1, Ordering::Relaxed) + 1;
+    let ms = elapsed.as_secs_f64() * 1000.0;
+    println!("Execution {}: {:.3} ms", n, ms);
+}
