            "TEST32rr",
            "TEST64rr"
          ],
          "require": [
            {
              "operand": 0,
              "field": "reg",
              "equals_capture": "setcc_dst"
            }
          ]
        },
        {
          "bind": "jcc",
          "opcode": "JCC_1",
          "require": [
            {
